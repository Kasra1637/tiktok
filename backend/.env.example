# HookForge backend environment.
#
# Copy to .env and fill in what you need. Everything here is optional except
# OPENROUTER_API_KEY, which is required for any AI feature (research, angles,
# plans, scripts, video). Never commit a real .env — only this example is
# tracked (.gitignore keeps .env and .env.* out).

# --- Required for AI features ---
OPENROUTER_API_KEY=

# --- Auth (optional locally, required hosted). Unset means auth is disabled
# and all access is "anonymous" — fine for local dev, but the server refuses
# to boot on Render or with ENVIRONMENT/APP_ENV=production without it. ---
CLERK_JWKS_URL=

# --- Public origin. Required for V2V references (the provider must fetch them). ---
PUBLIC_BASE_URL=

# --- Signed media URLs (optional). ---
MEDIA_URL_SECRET=

# --- Durable video storage (optional). Unset means videos don't survive a redeploy. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Cloud SQLite (optional). Unset uses local SQLite. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Frame-extraction offload (optional). ---
MODAL_FRAME_EXTRACTOR_URL=
MODAL_SHARED_SECRET=

# --- Browser origins (optional). Comma-separated. Defaults to *. ---
CORS_ORIGINS=

# --- Video provider (optional). ---
# Model key used when a render does not name one. Default: minimax-h3
VIDEO_MODEL_DEFAULT=
# Comma-separated keys the app may use at all. Empty means the built-in set.
VIDEO_MODEL_ALLOWLIST=

# --- Chat and vision models (optional). ---
# OpenRouter model slugs. Defaults: anthropic/claude-haiku-5.5
# After changing any of these, verify the slug:
#   python backend/verify_chat_model.py --model <slug>
AI_TEXT_MODEL=
AI_VISION_MODEL=
# Content angles only. Unset means AI_TEXT_MODEL; a stronger model here buys
# better angles without moving every utility call onto the expensive tier.
AI_ANGLE_MODEL=

# --- Set by Render automatically; do not set these by hand. ---
# RENDER, RENDER_EXTERNAL_URL, RENDER_SERVICE_NAME
