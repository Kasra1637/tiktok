# Copy this file to `.env` and fill in the values, then restart the server.

# Clerk JWKS endpoint — https://dashboard.clerk.com -> API Keys -> Advanced
# Used to verify the session JWTs the frontend sends on every request.
# If omitted, auth is DISABLED and every request is treated as user "anonymous".
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Signs the short-lived URLs that /api/media/videos/* now requires.
#
# That route has to work as a <video src> and an <a download>, neither of which
# can send an Authorization header, so authorization travels in the URL instead.
# Unset means a random per-process key: every restart then invalidates
# outstanding links, which is the safe way to fail, and nobody can accidentally
# run production on a hardcoded default. Set it in production so links survive a
# restart or a redeploy. Any random string; changing it invalidates old links.
MEDIA_URL_SECRET=

# AI features (hook analysis, face swap, video generation)
OPENROUTER_API_KEY=

# Trend Research scans (the only TikTok-data consumer left; the Discover feed is gone)
APIFY_API_TOKEN=

# Comma-separated allowed origins for CORS. Defaults to * when unset.
CORS_ORIGINS=

# Public HTTPS URL this server is reachable at (e.g. https://your-app.onrender.com).
# Required for "V2V motion transfer" video generation — OpenRouter's video API
# only accepts real HTTPS URLs for video references, not base64. Without this,
# video generation still works, just without the V2V motion reference.
# On Render this is auto-populated via RENDER_EXTERNAL_URL, so you usually
# don't need to set this manually there.
PUBLIC_BASE_URL=

# Turso database (free cloud SQLite — data persists across Render redeploys).
# Sign up at https://turso.tech and create a database. Then:
#   turso db tokens create <db-name>
# to get the auth token. Without these, the app falls back to local SQLite
# (works for dev, but data is lost on every Render redeploy).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Modal serverless worker for video download + frame extraction (see
# backend/modal_worker.py for deployment instructions). Moves this
# memory-heavy step off Render's 512MB free-tier instance, which was
# causing OOM crashes. Without these, the app runs yt-dlp/ffmpeg locally
# (the original behavior) — fine for local dev, risky on Render free tier.
MODAL_FRAME_EXTRACTOR_URL=
MODAL_SHARED_SECRET=

# Cloudflare R2 object storage for generated videos (see backend/storage_service.py).
# Videos are stored at {user_id}/{job_id}.mp4 and registered in video_assets.
# Without these, the app still works — videos just won't persist across deploys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom/public domain for serving videos. If unset, falls back to
# the R2 account endpoint (requires public bucket access).
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Video provider selection (see backend/video_providers.py)
# ---------------------------------------------------------------------------
# The provider used when a request does not name one. Any key from
# ai_service.VIDEO_MODELS works, so the model can be swapped with an
# environment change instead of a code change.
#   minimax-h3    5-15s per pass, 2K, native audio. Durations over 15s need a
#                 second generation for the remainder. Currently the only
#                 studio-eligible provider.
#   grok-imagine-video-lite  5-15s per pass, 720p, silent, photo as first
#                 frame. Distilled Grok Imagine for cheap drafts. Opt-in via
#                 the studio model picker; append its key to VIDEO_MODEL_ALLOWLIST
#                 below if the allowlist is pinned, or it will not be offered.
#   heygen-video-1  5-15s per pass, 768p, synthesized audio, photo as first
#                 frame. Business-video renderer for talking-head hooks and
#                 demos; the only opt-in with real audio. Opt-in via the studio
#                 model picker; append its key to VIDEO_MODEL_ALLOWLIST below
#                 if the allowlist is pinned, or it will not be offered.
# Video EDITORS (runway/aleph-2) are rejected by the template workflow: they
# edit an existing clip and cannot generate from a prompt.
#VIDEO_MODEL_DEFAULT=minimax-h3

# Comma-separated keys the app is permitted to use. Anything outside this list
# is refused, so a typo cannot silently route a render to an unvetted model.
# Defaults to "minimax-h3".
#VIDEO_MODEL_ALLOWLIST=minimax-h3

# ---------------------------------------------------------------------------
# Deterministic overlays (see backend/overlays.py)
# ---------------------------------------------------------------------------
# ffmpeg must be on PATH. It is required for TikTok frame extraction and for
# compositing captions and the CTA end card onto a generated clip. Without
# it, overlays are skipped and the un-composited video is kept.
#
# Font used for captions and the CTA end card. Resolved from a list of common
# system fonts when unset; override on a machine with different fonts.
# Windows example: C:\Windows\Fonts\segoeuib.ttf
#OVERLAY_FONT=
