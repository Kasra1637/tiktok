.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
# Bytecode suffixes only. This was "*pyc*", which is a substring match and
# silently ignored any path containing the letters p-y-c -- frontend/src/lib/
# copyCase.js was ignored by it, because "copyCase" contains "pyc" under git's
# case-insensitive matching on Windows. A source file vanishing from `git add`
# without a warning is the failure mode, so the pattern is anchored to the
# extension it was meant to describe.
*.pyc
*.pyd
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db
backend/storage/hookforge.db
backend/storage/hookforge.db-wal
backend/storage/hookforge.db-shm

# Saved hook template assets (generated at runtime per deployment)
backend/storage/templates/

# Poster thumbnails (generated at runtime per deployment, heal on demand)
backend/storage/posters/

# Uploaded user photos and generated clip files, written at runtime per
# deployment. Test runs leave real binaries here, so they stay untracked.
backend/storage/assets/

# Render pipeline output (finished clips, extracted frames, generated images,
# source uploads), written at runtime per deployment. Twenty-five of these were
# once committed and had to be untracked; nothing reads them from git.
backend/storage/videos/
backend/storage/frames/
backend/storage/generated/
backend/storage/uploads/

# backend/storage/samples/ is the exception: test_portrait.jpg is a test
# fixture read by test_asset_persistence.py and test_overlay_api.py, so it
# stays tracked. Nothing else belongs under backend/storage/.

# Manual DB backups taken before a migration
backend/storage/*.stale-*

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Local scratch: scoring/eval tooling and its notes, kept out of the repo
# (apply_score.ps1 rewrites backend/server.py from these files)
backend/.rec_tmp/
.freebuff/

.env
.env.*
*.env
# ...but DO track the committed templates that document which vars are needed.
!.env.example
!**/.env.example
credentials.json
*.key
.credentials

# Cloud Run service spec. Once the <FILL: ...> placeholders are replaced this file
# holds live credentials for Turso, R2 and Modal, and unlike service.yaml's
# secretKeyRef entries those are plain values with no reference to protect them.
# The committed template shape (service.yaml.template) documents the structure.
service.yaml
