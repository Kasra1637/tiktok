# Copy this file to `.env` and fill in the values, then restart the dev server.
# Create React App inlines REACT_APP_* variables at BUILD time — changing them
# requires a rebuild/restart, not just a page refresh.

# Clerk publishable key — https://dashboard.clerk.com -> API Keys
# Safe to expose publicly (it ships in the JS bundle by design).
# If omitted, the app still runs but sign-in/sign-up are disabled and all data
# is stored under the shared "anonymous" user.
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend origin. Leave empty for same-origin (the production Docker image
# serves the API and the frontend together).
REACT_APP_BACKEND_URL=
